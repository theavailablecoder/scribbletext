# API Keys Configuration
# Add your Gemini API keys below (one per line)
# The system will automatically rotate between them when limits are reached

# IMPORTANT: Never commit this file to git!
# Add .env to your .gitignore file

VITE_API_KEY_1=
VITE_API_KEY_2=
VITE_API_KEY_3=
VITE_API_KEY_4=

# Optional: Set which key to start with (1-4)
VITE_STARTING_KEY=1

# Backend API URL (for production deployment)
# Leave empty for localhost development
VITE_API_URL=

# ===== BACKEND ENV VARS (for Render) =====
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
